generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  username   String?     @unique
  name       String?
  password   String?    // null for Google OAuth
  avatar     String?
  googleId   String?    @unique
  isVerified Boolean    @default(false)

  destinations Destination[]
  itineraries  Itinerary[]
  likes        Like[]
  comments     Comment[]
  ratings      Rating[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ---------- Standalone destinations (optional, for future community spotlights) ----------
model Destination {
  id          String   @id @default(uuid())
  name        String
  latitude    Float
  longitude   Float
  description String?
  address     String?
  distance    Float?
  duration    String?

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      Photo[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Photo {
  id            String      @id @default(uuid())
  url           String
  public_id     String?
  caption       String?
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

// ---------- Itinerary (ride plan) ----------
model Itinerary {
  id            String    @id @default(uuid())
  name          String
  description   String?
  coverPhoto    String?
  estimatedTime String?     // e.g. "2 hours"
  totalDistance Float?      // in km
  difficulty    String?     // "Easy", "Medium", "Hard"
  tags          String[]    // PostgreSQL array, or use a String + parse JSON if you prefer
  visibility    String    @default("public")  // "public", "private", "unlisted"

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  stops         Stop[]
  likes         Like[]
  comments      Comment[]
  ratings       Rating[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------- Stop (a point on the route) ----------
model Stop {
  id            String    @id @default(uuid())
  order         Int
  name          String
  latitude      Float
  longitude     Float
  address       String?
  description   String?
  arrivalNotes  String?
  estimatedStay String?   // e.g. "30 mins"

  itineraryId   String
  itinerary     Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  photos        StopPhoto[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StopPhoto {
  id        String   @id @default(uuid())
  url       String
  public_id String?
  caption   String?
  stopId    String
  stop      Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ---------- Interactions (on itineraries) ----------
model Like {
  id          String    @id @default(uuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, itineraryId])
}

model Comment {
  id          String    @id @default(uuid())
  text        String
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Rating {
  id          String    @id @default(uuid())
  score       Int       // 1-5
  review      String?
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, itineraryId])
}